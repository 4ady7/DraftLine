DATABASE_URL="file:./dev.db"

# mock uses the demo corpus and deterministic agents.
# live uses an OpenAI-compatible chat completions API.
DRAFTLINE_MODE=mock

# Required only for live mode.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000

# Optional. Live research fails visibly until this is set.
TAVILY_API_KEY=
SEARCH_TIMEOUT_MS=15000

# Timing knobs. Tests set both to 0.
DRAFTLINE_STAGE_DELAY_MS=280
DRAFTLINE_RETRY_DELAY_MS=200

# Set to 1 to show failure simulation outside local development.
DRAFTLINE_FAULTS=0
