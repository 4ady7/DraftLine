{
  "name": "draftline",
  "version": "1.0.0",
  "private": true,
  "description": "Human-in-the-loop editorial workflow for turning a rough brief into a reviewable first draft.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "prisma generate && DATABASE_URL=file:./test.db prisma db push --skip-generate --accept-data-loss && vitest run",
    "db:push": "prisma db push",
    "db:test": "DATABASE_URL=file:./test.db prisma db push --skip-generate --accept-data-loss",
    "postinstall": "prisma generate && prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "prisma": "^6.16.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
